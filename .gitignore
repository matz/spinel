# Analyze-only emit artifacts (--emit-types / --emit-symbol-map, and the
# symbol map --profile writes beside the binary).
# Not *.rbs: test/rbs/ and test/rbs-seed/ carry tracked .rbs fixtures.
*.types.json
*.symbols.json

