<!--SVG Background-->
<rect width='500' height='300' x='0' y='0' class='svgBackground'/>
<g transform='translate( 50 20 )'>
<rect x='0' y='0' width='400' height='250' class='graphBackground'/>
<g>
<text x='10' y='20' class='dataPointLabel'>
12 &amp; &lt;13&gt;
</text>
<text x='30' y='40' class='dataPointLabel'>
a long title with whitespace that runs on and on past the eighty column width of
the formatter
</text>
<g id='popup' visibility='hidden'>
<circle cx='5' cy='6' r='10'/>
</g>
</g>
</g>
<text x='250' class='mainTitle'>
Title
</text>
</svg>
